# Variabili d'ambiente per il sistema RAG (Data Privacy)

# Indirizzo del Server Ollama Aziendale (tramite VPN)
OLLAMA_URL="http://INSERISCI_IP_AZIENDALE:INSERISCI_PORTA"

# Modello generativo verificato sul server
OLLAMA_LLM_MODEL="gemma3:4b"

# Percorso di salvataggio del Database Vettoriale locale (SSD)
QDRANT_STORAGE_PATH="./mio_database_vettoriale"